*.log
.DS_Store
# Toutes les variantes d'environnement, sauf le modèle : une liste de noms
# précis laissait passer un .env.docker-test ou un .env.local, avec les
# secrets qu'il contient.
.env
.env.*
!.env.example
# Modèle de configuration cPanel : un exemple sans secret, que build.sh
# copie dans l'archive. La règle .env.* ci-dessus l'excluait.
!deploy/cpanel/.env.cpanel.example
