# =============================================================================
#  Configuration de production — hébergement mutualisé (cPanel)
# =============================================================================
#
#  À copier en « .env » DANS LE DOSSIER DE L'APPLICATION (/home/COMPTE/app),
#  jamais dans la racine web : ce fichier contient vos identifiants de base
#  et vos clés de paiement.
#
#  Après toute modification, régénérez les caches :
#      php artisan config:cache && php artisan route:cache && php artisan view:cache
#
# -----------------------------------------------------------------------------

APP_NAME="Électroniques Stores"
APP_ENV=production

# JAMAIS true en production : afficherait vos identifiants de base sur la
# moindre page d'erreur, à tout visiteur.
APP_DEBUG=false

# Générez-la sur votre machine avec : php artisan key:generate --show
# Sans elle, toutes les pages renvoient une erreur 500.
APP_KEY=

# L'adresse publique exacte, en https. Sert aux liens des emails et au
# webhook de paiement.
APP_URL=https://votre-domaine.com

APP_LOCALE=fr
APP_TIMEZONE=UTC

# -----------------------------------------------------------------------------
#  Base de données — créée depuis cPanel > « Bases de données MySQL »
# -----------------------------------------------------------------------------
#  cPanel préfixe le nom de la base et de l'utilisateur avec votre compte :
#  une base « boutique » devient « moncompte_boutique ». Reprenez le nom
#  complet tel qu'affiché.

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=moncompte_boutique
DB_USERNAME=moncompte_boutique
DB_PASSWORD=

# -----------------------------------------------------------------------------
#  Sessions, cache et file d'attente
# -----------------------------------------------------------------------------
#  Tout passe par la base : un mutualisé n'offre ni Redis ni Memcached.

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# Les journaux dans un fichier quotidien, conservé 14 jours : « single »
# laisserait grossir un fichier unique jusqu'à saturer votre quota.
LOG_CHANNEL=daily
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
#  Envoi des emails
# -----------------------------------------------------------------------------
#  Créez une adresse dans cPanel > « Comptes de messagerie », puis reprenez
#  ses paramètres ici. Sans configuration valide, le client ne reçoit aucune
#  confirmation et vous aucune alerte de commande.

MAIL_MAILER=smtp
MAIL_HOST=mail.votre-domaine.com
MAIL_PORT=465
MAIL_USERNAME=boutique@votre-domaine.com
MAIL_PASSWORD=
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS=boutique@votre-domaine.com
MAIL_FROM_NAME="${APP_NAME}"

# Destinataire des alertes de nouvelle commande.
SHOP_ADMIN_EMAIL=boutique@votre-domaine.com

# -----------------------------------------------------------------------------
#  Paiement en ligne (PayDunya)
# -----------------------------------------------------------------------------
#  Laissez vide tant que vous n'avez pas de compte : seul le paiement à la
#  livraison sera alors proposé, sans erreur.
#
#  Le webhook exige une URL publique en https — c'est le cas sur cPanel une
#  fois le certificat AutoSSL actif.

PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=live

# -----------------------------------------------------------------------------
#  Premier administrateur
# -----------------------------------------------------------------------------
#  Utilisé une seule fois, par le seeder, à la création du compte. Retirez
#  cette ligne ensuite : le mot de passe n'a pas à rester en clair sur le
#  serveur. Si vous la laissez vide, un mot de passe aléatoire est généré
#  et affiché dans la sortie du seeder.

ADMIN_DEFAULT_PASSWORD=

# -----------------------------------------------------------------------------
#  Divers
# -----------------------------------------------------------------------------

SHOP_CURRENCY=XOF
SHOP_CURRENCY_SYMBOL=FCFA

# Surface maximale d'une image envoyée. Un mutualisé dispose de peu de
# mémoire : abaissez cette valeur (20000000 pour 20 Mpx) si l'envoi d'une
# photo échoue.
SHOP_MAX_IMAGE_PIXELS=40000000

VITE_APP_NAME="${APP_NAME}"
